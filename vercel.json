{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "checkout.html", "use": "@vercel/static" },
    { "src": "about.html", "use": "@vercel/static" },
    { "src": "contact.html", "use": "@vercel/static" },
    { "src": "refund.html", "use": "@vercel/static" },
    { "src": "terms.html", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "api/create-order.js", "use": "@vercel/node" },
    { "src": "index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/create-order", "dest": "/api/create-order.js" },
    { "src": "/about.html", "dest": "/about.html" },
    { "src": "/contact.html", "dest": "/contact.html" },
    { "src": "/refund.html", "dest": "/refund.html" },
    { "src": "/terms.html", "dest": "/terms.html" },
    { "src": "/checkout.html", "dest": "/checkout.html" },
    { "src": "/logo.jpg", "dest": "/logo.jpg" },
    { "src": "/logo-full.jpg", "dest": "/logo-full.jpg" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
